# Copy to telegram-bot/.env and fill in the token. Existing environment
# variables always win over this file, and nothing here is executed.

# Required. Ask @BotFather for /newbot and paste the token.
BOT_TOKEN=123456789:replace-with-the-token-from-BotFather

# Where results are written between restarts.
# Default: telegram-bot/.data/results.json
#DATA_FILE=/var/lib/gad7-phq9-bot/results.json

# Keep everything in memory only. Results are lost on restart.
#MEMORY_ONLY=0

# Weekly reminder. Default: Monday at 19:00 Kyiv time.
# REMINDER_WEEKDAY is 0 for Sunday through 6 for Saturday.
#REMINDER_TIME=19:00
#REMINDER_WEEKDAY=1

# The zone resolves the offset per instant, so the local send hour survives the
# March and October transitions on its own. Nothing to edit twice a year.
#REMINDER_ZONE=Europe/Kyiv

# Set this only to pin a fixed offset instead. It overrides REMINDER_ZONE and
# then follows no seasonal rule.
#REMINDER_UTC_OFFSET=

# A weekly slot missed by more than this many hours is skipped, not sent late.
#REMINDER_GRACE_HOURS=12

# Where to point a user who marks thoughts of self-harm in PHQ-9 item 9.
# The default lists Ukrainian services. Replace for another country.
#CRISIS_CONTACT=Екстрена допомога: 103 або 112. LifeLine Ukraine: 7333

# Long polling and scheduling tuning.
#POLL_TIMEOUT_SECONDS=50
#TICK_SECONDS=60
#SESSION_IDLE_MINUTES=60

# Price of the one-time full access, in Telegram Stars, and the free trial
# length in days. 100 Stars is roughly 100 UAH for the buyer; what reaches you
# is less, see the README.
#PRICE_STARS=100
#TRIAL_DAYS=14
#PRICE_TITLE=Повний доступ
#PRICE_DESCRIPTION=Шкали сну і стресу, повна історія та статистика. Одноразово, без підписки.

# Mini App. The https address of telegram-bot/webapp/ once it is deployed.
# Leave it unset to run the chat-only flow with no window.
#WEBAPP_URL=https://your-app.pages.dev/

# Alternative Bot API endpoint, for a local Bot API server.
#API_BASE=https://api.telegram.org
